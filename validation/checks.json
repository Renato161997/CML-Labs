  "labs/200-301-ccna-implementing-and-administering-cisco-solutions/ip-connectivity/018-ospfv2-neighbor-troubleshooting.yaml": {
    "checks": [
      {
        "node": "R1",
        "command": "show ip ospf neighbor",
        "pattern": "FULL",
        "expectation": "No FULL neighbor before repair; FULL after repair.",
        "negative": false
      },
      {
        "node": "R1",
        "command": "ping 192.0.2.2 source Loopback0 repeat 3",
        "pattern": "Success rate is 100 percent",
        "expectation": "Loopback ping passes after repair.",
        "negative": false
      }
    ],
    "repair": {
      "node": "R2",
      "commands": [
        "configure terminal",
        "router ospf 10",
        "no network 198.18.0.0 0.0.0.3 area 1",
        "no network 192.0.2.2 0.0.0.0 area 1",
        "network 198.18.0.0 0.0.0.3 area 0",
        "network 192.0.2.2 0.0.0.0 area 0",
        "end"
      ]
    },
    "initial": "R1 uses area 0 and R2 uses area 1 on the same link."
  },
